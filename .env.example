# Copy this file to .env.local and fill in real values.
# .env.local is gitignored.

# --- Database (Neon Postgres) ---
# Connection string used by Drizzle and the app at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# --- Better Auth (admin login) ---
# A random secret. Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL used for auth callbacks. Use the deployed URL in production.
BETTER_AUTH_URL=http://localhost:3000

# --- Cloudflare R2 (image uploads) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public URL prefix served from your R2 bucket (e.g. https://pub-xxxx.r2.dev)
R2_PUBLIC_URL=

# --- Public site config (exposed to the browser) ---
# Used in SEO, JSON-LD, and absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp business number in international format, no plus sign (e.g. 923340686243).
# Leave blank to hide WhatsApp buttons.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Transactional email (Resend) ---
# API key from https://resend.com/api-keys. Leave blank to disable emails
# (the order flow still works; emails are simply skipped).
RESEND_API_KEY=
# "From" address. Must be on a domain you've verified in Resend (add the DNS
# records it gives you for shapparels.pk). Before verifying, you can test with
# "SH Apparels <onboarding@resend.dev>".
EMAIL_FROM="SH Apparels <orders@shapparels.pk>"
# Where new-order alerts are sent. Comma-separate for multiple recipients.
STORE_NOTIFICATION_EMAIL=

# --- WhatsApp notifications (Twilio) ---
# From the Twilio Console. Leave blank to disable auto-WhatsApp (the manual
# one-click admin buttons still work without any of this).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp sender. Sandbox: +14155238886 (for testing — customers must first
# message the sandbox join code). Production: your approved WhatsApp number.
TWILIO_WHATSAPP_FROM=
# Optional: a dedicated number (digits, e.g. 923331711108) to receive store
# new-order alerts. Defaults to NEXT_PUBLIC_WHATSAPP_NUMBER.
TWILIO_ADMIN_WHATSAPP=
# Optional: approved Content Template SIDs (HXxxxx…) for messages sent outside
# the 24h window in PRODUCTION. Without these, freeform text is used (works in
# the sandbox / within an open 24h customer session only).
#   order_placed vars: {{1}} name, {{2}} order #, {{3}} total
#   confirmed/cancelled vars: {{1}} name, {{2}} order #
#   shipped vars: {{1}} name, {{2}} order #, {{3}} courier + tracking
TWILIO_WA_TEMPLATE_ORDER_PLACED=
TWILIO_WA_TEMPLATE_CONFIRMED=
TWILIO_WA_TEMPLATE_SHIPPED=
TWILIO_WA_TEMPLATE_CANCELLED=

# Facebook App ID (Business Manager) — renders <meta property="fb:app_id">.
NEXT_PUBLIC_FB_APP_ID=
